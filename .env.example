# Kopiera till .env och fyll i värdena: cp .env.example .env

# TMDB API Read Access Token (v4, "eyJ...") eller API-nyckel (v3)
TMDB_API_KEY=

# Skyddar /api/admin/* (scripts/update-ratings.ts). Minst 32 tecken,
# till exempel: openssl rand -hex 32
ADMIN_TOKEN=

# PIN-kod för synkknappen (exakt 4 tecken)
SYNC_PIN=
